{
  "entities": {
    "User": {
      "title": "User",
      "description": "A user of the application, including their profile and settings.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "The user's display name."
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "The user's email address."
        },
        "avatarUrl": {
          "type": "string",
          "description": "URL to the user's avatar image."
        },
        "settings": {
          "type": "object",
          "description": "User's application settings.",
          "properties": {
            "darkMode": {
              "type": "boolean"
            },
            "notifications": {
              "type": "boolean"
            },
            "startOfWeek": {
              "type": "string",
              "enum": ["Monday", "Sunday"]
            }
          },
          "required": ["darkMode", "notifications", "startOfWeek"]
        }
      },
      "required": ["name", "email", "settings"]
    },
    "Goal": {
      "title": "Goal",
      "description": "A habit or goal tracked by the user.",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "description": "The title of the goal."
        },
        "frequency": {
          "type": "string",
          "enum": ["Daily", "Weekdays", "Weekly"],
          "description": "How often the goal should be completed."
        },
        "targetValue": {
          "type": "number",
          "description": "The target quantity for the goal."
        },
        "targetUnit": {
          "type": "string",
          "enum": ["times", "mins", "pages", "liters"],
          "description": "The unit of measurement for the target value."
        },
        "smartReminders": {
          "type": "boolean",
          "description": "Whether smart reminders are enabled for this goal."
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp of when the goal was created."
        },
        "completions": {
          "type": "array",
          "items": {
            "type": "string",
            "description": "ISO date string (YYYY-MM-DD)"
          },
          "description": "List of dates when the goal was completed."
        },
        "isSuspended": {
          "type": "boolean",
          "description": "Whether the goal is currently suspended."
        }
      },
      "required": ["title", "frequency", "targetValue", "targetUnit", "smartReminders", "createdAt", "completions", "isSuspended"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/User"
      },
      "description": "Stores user profiles and settings."
    },
    "/users/{userId}/goals/{goalId}": {
      "schema": {
        "$ref": "#/entities/Goal"
      },
      "description": "Stores individual goals for a user."
    }
  }
}
